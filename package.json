{
  "name": "{{project-name}}",
  "version": "0.1.0",
  "description": "{{description}}",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "bun run wasm-build:dev && vite dev",
    "tdev": "tauri dev",
    "build": "bun run wasm-build && vite build",
    "tbuild": "tauri build",
    "android:init": "tauri android init --ci",
    "android:dev": "tauri android dev",
    "android:apk": "tauri android build --debug --apk --target aarch64 --ci",
    "ios:init": "tauri ios init --ci",
    "ios:dev": "tauri ios dev",
    "preview": "vite preview",
    "check": "bun run wasm-build && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "bun run wasm-build && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "wasm-build": "wasm-pack build wasm --target web --out-dir ../src/lib/wasm --out-name app_wasm",
    "wasm-build:dev": "wasm-pack build wasm --target web --out-dir ../src/lib/wasm --out-name app_wasm --no-opt",
    "test": "cargo test --workspace --exclude app-wasm",
    "release:prepare": "node scripts/prepare-release.mjs",
    "test:release": "node --test scripts/prepare-release.test.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-os": "^2.4.0"
  },
  "devDependencies": {
    "@skeletonlabs/skeleton": "^5.0.4",
    "@skeletonlabs/skeleton-svelte": "^5.0.4",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "binaryen": "^132.0.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.7"
  }
}
